# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL 16)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mycalendar
DB_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mycalendar?schema=public

# Redis Cache & Queue
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication (JWT)
JWT_SECRET=mycalendar_jwt_development_secret_key_12345

# Google Calendar OAuth (Phase 2 & 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
