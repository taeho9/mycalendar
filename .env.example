# Application
NODE_ENV=development
PORT=3000
TZ=Asia/Seoul

# Database (PostgreSQL 16)
# [SECURITY NOTICE] 프로덕션(Portainer) 배포 시 반드시 강력한 무작위 비밀번호로 변경하세요.
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here
DB_NAME=mycalendar
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}?schema=public

# Redis Cache & Queue
REDIS_HOST=redis
REDIS_PORT=6379

# Authentication (JWT)
# [SECURITY NOTICE] 프로덕션에서는 반드시 32자 이상의 무작위 키로 변경하세요 (예: openssl rand -base64 32).
JWT_SECRET=your_jwt_super_secret_key_minimum_32_characters

# Google Calendar OAuth (Phase 2 & 3)
# Google Cloud Console에서 발급받은 백엔드용 자격증명
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://calendar.godlife.io:6690/api/v1/auth/google/callback
